# =====================================================================
# Powerhouse — production environment template
# =====================================================================
# Copy to .env on the production host and fill every blank. This file
# is committed for REFERENCE ONLY — it must never contain real secrets.
# Required PHP: 8.3+ (see composer.json "php": "^8.3").
# =====================================================================

# --- Application ----------------------------------------------------
APP_NAME=Powerhouse
APP_ENV=production
APP_KEY=                              # php artisan key:generate
APP_DEBUG=false                       # MUST be false in production
APP_URL=https://hub.whitedash.com
APP_TIMEZONE=Europe/London

# Filesystem (explicit for cPanel):
FILESYSTEM_DISK=local

# Portal + referrer sub-paths (used for absolute links in emails)
PORTAL_URL=https://hub.whitedash.com/account
REFERRER_URL=https://hub.whitedash.com/partners

# First super-admin (seeded once, then change in the UI)
SUPER_ADMIN_NAME=Apostolos Michailidis
SUPER_ADMIN_EMAIL=am@whitedash.com
SUPER_ADMIN_PASSWORD=                 # strong unique password — NOT the dev default

# --- Logging --------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily                       # daily rotation in prod (single in dev)
LOG_LEVEL=error                       # production: errors only

# --- Database -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=                          # cPanel DB name (e.g. whiteda_powerhouse)
DB_USERNAME=                          # cPanel DB user
DB_PASSWORD=                          # cPanel DB password

# --- Queue + Session + Cache ---------------------------------------
QUEUE_CONNECTION=database             # NOT sync — a worker must run (see GO-LIVE)
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true            # HTTPS only in production
SESSION_SAME_SITE=lax
CACHE_STORE=file                      # file cache (no Redis on shared host)

# --- Mail (Postmark) ------------------------------------------------
MAIL_MAILER=postmark
POSTMARK_TOKEN=                       # Postmark Server API token
MAIL_FROM_ADDRESS=noreply@whitedash.com
MAIL_FROM_NAME="Powerhouse"

# Postmark inbound (support@ → ticket replies)
POSTMARK_INBOUND_SECRET=             # shared secret in the inbound webhook URL
SUPPORT_INBOUND_EMAIL=support@whitedash.com

# --- Stripe (LIVE keys) --------------------------------------------
STRIPE_KEY=pk_live_                   # publishable
STRIPE_SECRET=sk_live_                # secret — smoke:test asserts sk_live_ prefix
STRIPE_WEBHOOK_SECRET=whsec_          # from the prod webhook endpoint

# --- Google (OAuth + Calendar) -------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://hub.whitedash.com/account/google/callback

# --- WHM / cPanel + PageSpeed --------------------------------------
WHM_SERVER=040hosting.eu
WHM_API_TOKEN=
PAGESPEED_API_KEY=

# --- Cloudflare (domain/SSL sync) ----------------------------------
CLOUDFLARE_API_TOKEN=                 # rotate — dev token must not be reused

# --- MainWP ---------------------------------------------------------
MAINWP_URL=
MAINWP_CONSUMER_KEY=
MAINWP_CONSUMER_SECRET=

# --- Products (OAuth consumers + outbound webhooks) ----------------
MAAVELUS_APP_URL=https://restaurant.maavelus.co.uk
MAAVELUS_WEBHOOK_SECRET=
MYORDERPAD_APP_URL=https://myorderpad.co.uk
MYORDERPAD_WEBHOOK_SECRET=

# Product OAuth (Passport consumer credentials)
MAAVELUS_OAUTH_SECRET=
MYORDERPAD_OAUTH_SECRET=
WHITEDASH_PORTAL_OAUTH_SECRET=

# --- QuickBooks Online (optional) ----------------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Sentry
SENTRY_LARAVEL_DSN=https://xxx@xxx.ingest.de.sentry.io/xxx
SENTRY_SEND_DEFAULT_PII=false         # GDPR: don't ship IPs/request bodies/auth context to Sentry
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0


# SSO shared secret (same in Powerhouse
# AND MyOrderPad .env):
POWERHOUSE_SSO_SECRET=

# API key Powerhouse uses to call
# MyOrderPad's provision endpoint:
MYORDERPAD_API_KEY=